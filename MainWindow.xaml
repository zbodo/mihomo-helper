<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MihomoTray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mihomo Helper">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Mihomo Helper">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/mihomo-wrench.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="ContentPanel"
                MinWidth="360"
                HorizontalAlignment="Stretch"
                Padding="20,4,20,20"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="状态" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="0"
                            Click="OnRefresh"
                            Content="刷新" />
                    </Grid>
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid
                        MinHeight="136"
                        ColumnSpacing="16"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            Text="系统代理" />
                        <TextBlock
                            x:Name="ProxyStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontWeight="SemiBold"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            Text="TUN" />
                        <TextBlock
                            x:Name="TunStatusText"
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontWeight="SemiBold"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            Text="内核" />
                        <TextBlock
                            x:Name="KernelStatusText"
                            Grid.Row="2"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            LineHeight="20"
                            LineStackingStrategy="BlockLineHeight"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="16">
                    <ContentControl
                        x:Name="KernelPathPanel"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="False">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="内核路径" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="KernelPathBox"
                                    PlaceholderText="选择或粘贴 mihomo 内核 exe" />
                                <Button
                                    Grid.Column="1"
                                    Click="OnBrowseKernel"
                                    Content="浏览" />
                                <Button
                                    Grid.Column="2"
                                    Click="OnOpenKernelPath"
                                    Content="打开" />
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="工作模式" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ProxyToggleButton"
                                HorizontalAlignment="Stretch"
                                Click="OnToggleProxy"
                                IsEnabled="False"
                                Content="切换系统代理" />
                            <Button
                                x:Name="TunToggleButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="OnToggleTun"
                                IsEnabled="False"
                                Content="切换 TUN" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="WebUiButton"
                                HorizontalAlignment="Stretch"
                                Click="OnOpenWebUi"
                                IsEnabled="False"
                                Content="启动 WEBUI" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="OnStartKernel"
                                Content="启动内核" />
                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="OnStopKernel"
                                Content="终止内核" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="计划任务" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" Click="OnInstallTask" Content="添加任务" />
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnRemoveTask" Content="删除任务" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
